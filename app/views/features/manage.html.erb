<h1>Features</h1>

<%= render partial: 'form' %>

<div class="row">
  <ul class="features list large-6 large-centered columns">
    <% @features.each_with_index do |feature, i| %>
      <%= render partial: 'feature', locals: { feature: feature, first: i.zero?, last: i == @features.size - 1 } %>
    <% end %>
  </ul>
</div>
